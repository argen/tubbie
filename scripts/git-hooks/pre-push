#!/usr/bin/env bash
# tubbie's local quality gate. Replaces CI checks the user opted out
# of (Free-plan minute budget). Installed via `just install-hooks`.
#
# Always runs (on every push, any branch):
#   - tfl-crates frozen check (iOS submodule firewall)
#   - tauri.conf.json <-> Cargo.toml version lockstep
#
# Feature branches (feat/*, fix/*, chore/*) additionally run:
#   - cargo fmt --all -- --check  (Rust formatting — CI's rust job runs this first)
#   - cargo test --workspace
#   - cd web && npm run verify   (lint + format:check + typecheck + test)
#   - cargo clippy --workspace --all-targets -- -D warnings
#
# Why `npm run verify` over just `npm test`: PR-E shipped 17 lint +
# 4 prettier + 5 typecheck errors past `npm test` because vitest
# doesn't care about either; only the full verify gate catches them.
# Cost is ~10s extra on push. Worth it.
#
# Why the `cargo fmt --check` gate: a 6-PR stack landed with rustfmt
# drift that the local gate waved through (it ran test/clippy/web but
# not Rust fmt), so CI's `cargo fmt --all -- --check` red-flagged all
# six. `npm run verify` already covers web formatting; this is the
# Rust mirror. Fail-fast first, matching CI's order.
#
# To skip in an emergency: `git push --no-verify`. Doc-only branches
# (docs/*) skip the full gate by design; the always-on checks still
# run.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "${ROOT}"

# Always-on checks
"${ROOT}/scripts/check-tfl-crates-frozen.sh" origin/main
"${ROOT}/scripts/check-version-lockstep.sh"

branch="$(git rev-parse --abbrev-ref HEAD)"
case "${branch}" in
  feat/*|fix/*|chore/*)
    echo "[pre-push] running full local gate for ${branch}"
    cargo fmt --all -- --check
    cargo test --workspace
    ( cd web && npm run verify --silent )
    cargo clippy --workspace --all-targets -- -D warnings
    ;;
  docs/*|main|HEAD)
    echo "[pre-push] doc-only branch — skipping cargo/web gate"
    ;;
  *)
    # Unknown branch shape — default to running the full gate.
    echo "[pre-push] non-standard branch ${branch} — running full gate"
    cargo fmt --all -- --check
    cargo test --workspace
    ( cd web && npm run verify --silent )
    cargo clippy --workspace --all-targets -- -D warnings
    ;;
esac
