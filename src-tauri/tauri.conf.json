{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tubbie",
  "identifier": "app.tubbie",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../web/build",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "sh -c 'cd web 2>/dev/null || cd ../web; npm run build'",
    "beforeDevCommand": "sh -c 'cd web 2>/dev/null || cd ../web; npm run dev'"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tubbie",
        "width": 380,
        "height": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://api.tfl.gov.uk; img-src 'self' data:; font-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "copyright": "© 2026 Bruno Belcastro",
    "shortDescription": "London Underground tube arrivals board",
    "longDescription": "A desktop dot-matrix tube arrivals board powered by TfL's Unified API. View real-time arrivals for any London Underground station with classic amber LED aesthetics.",
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null,
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0REEwOUJDOTc5QUJDQzMKUldURHZKcVh2QW5hNVBTSWhlUklIZllKODRNY25oV214UThPU25ZMDI2NFR4MFZrbTJtT1VEQ1AK",
      "endpoints": [
        "https://github.com/argen/tubbie/releases/latest/download/latest.json"
      ]
    }
  }
}
