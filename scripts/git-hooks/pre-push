#!/usr/bin/env bash
# tubbie's local quality gate. Replaces CI checks the user opted out
# of (Free-plan minute budget). Installed via `just install-hooks`.
#
# Always runs (on every push, any branch):
#   - tfl-crates frozen check (iOS submodule firewall)
#   - tauri.conf.json <-> Cargo.toml version lockstep
#
# Feature branches (feat/*, fix/*, chore/*) additionally run:
#   - cargo test --workspace
#   - cd web && npm test
#   - cargo clippy --workspace --all-targets -- -D warnings
#
# To skip in an emergency: `git push --no-verify`. Doc-only branches
# (docs/*) skip the full gate by design; the always-on checks still
# run.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "${ROOT}"

# Always-on checks
"${ROOT}/scripts/check-tfl-crates-frozen.sh" origin/main
"${ROOT}/scripts/check-version-lockstep.sh"

branch="$(git rev-parse --abbrev-ref HEAD)"
case "${branch}" in
  feat/*|fix/*|chore/*)
    echo "[pre-push] running full local gate for ${branch}"
    cargo test --workspace
    ( cd web && npm test --silent )
    cargo clippy --workspace --all-targets -- -D warnings
    ;;
  docs/*|main|HEAD)
    echo "[pre-push] doc-only branch — skipping cargo/web gate"
    ;;
  *)
    # Unknown branch shape — default to running the full gate.
    echo "[pre-push] non-standard branch ${branch} — running full gate"
    cargo test --workspace
    ( cd web && npm test --silent )
    cargo clippy --workspace --all-targets -- -D warnings
    ;;
esac
