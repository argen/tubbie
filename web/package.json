{
  "name": "@tubbie/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --output machine-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "precommit": "lint-staged && npm run typecheck && npm run test",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "prepare": "svelte-kit sync",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "cd web && npm run precommit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,svelte}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "happy-dom": "20.11.6",
    "jiti": "2.7.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "simple-git-hooks": "2.13.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "svelte-eslint-parser": "1.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-opener": "2.5.4"
  },
  "overrides": {
    "cookie": "^0.7.0"
  }
}
