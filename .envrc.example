# tubbie — signed-release environment template.
#
# Copy this to `.envrc` (gitignored) and fill in the real values, then
# `source .envrc` before `just release-local` / `just release`. If you
# use direnv, `direnv allow` will source it automatically on `cd`.
#
# The committed copy is `.envrc.example`. The active `.envrc` is
# gitignored — never commit your filled-in copy.

# ---- Apple code-signing ---------------------------------------------------

# Team ID: 10-char alphanumeric from Apple Developer → Membership.
export APPLE_TEAM_ID="REPLACE_WITH_TEAM_ID"

# Apple ID (the email address you sign in with at appleid.apple.com).
export APPLE_ID="REPLACE_WITH_APPLE_ID_EMAIL"

# Exact Common Name of your Developer ID Application certificate as
# `codesign --sign` sees it. Confirm via
# `security find-identity -p codesigning -v`.
export APPLE_SIGNING_IDENTITY="Developer ID Application: YOUR NAME (TEAM_ID)"

# ---- Tauri updater signing -----------------------------------------------

# Path to the Ed25519 private key generated by
# `cargo tauri signer generate`. chmod 600 the file.
export TAURI_SIGNING_PRIVATE_KEY_PATH="$HOME/.tauri/tubbie-updater.key"
export TAURI_SIGNING_PRIVATE_KEY="$TAURI_SIGNING_PRIVATE_KEY_PATH"

# Key password is NEVER stored on disk. If you generated the key
# with a password, `cargo tauri build` prompts for it at release time.

# ---- Apple notarytool (App Store Connect API key) -------------------------

# Path to the API key (.p8 file). Generated once at
# appstoreconnect.apple.com → Users and Access → Integrations.
# Standard location is ~/.appstoreconnect/private_keys/, chmod 600.
# Apple does not let you re-download — keep a backup in 1Password.
export NOTARY_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_KEYID.p8"

# Key ID for the API key above (10-char alphanumeric on the
# Integrations page).
export NOTARY_KEY_ID="REPLACE_WITH_KEY_ID"

# Issuer ID for the App Store Connect API (UUID at the top of the
# Integrations page). Identifies the team that owns the key.
export NOTARY_ISSUER="REPLACE_WITH_ISSUER_UUID"
