#!/usr/bin/env bash
#
# tubbie — one-command dev launcher.
#
# Usage: ./dev
#
# No global tooling required beyond Node 24 and a Rust toolchain (rustup).
# Everything else — the Tauri CLI, Vite — is resolved from web/node_modules,
# so you don't need `cargo install tauri-cli` or a global `vite`, and you
# don't need `just`.
set -euo pipefail

# Always operate from the repo root, regardless of where this is invoked.
cd "$(dirname "$0")"

note() { printf '\033[1;36m▸ %s\033[0m\n' "$1"; }
fail() { printf '\033[1;31m✗ %s\033[0m\n' "$1" >&2; exit 1; }

# --- Prerequisites -----------------------------------------------------------
command -v node >/dev/null 2>&1 || fail "Node.js not found. Install Node 24 (see web/.nvmrc)."
command -v cargo >/dev/null 2>&1 || fail "Rust not found. Install via https://rustup.rs."

want_node="$(cat web/.nvmrc 2>/dev/null || echo 24)"
have_node="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$have_node" != "$want_node" ]; then
  printf '\033[1;33m! Node %s detected; this project targets Node %s. Continuing anyway.\033[0m\n' \
    "$have_node" "$want_node"
fi

# --- Frontend deps (includes the local Tauri CLI) ----------------------------
if [ ! -x web/node_modules/.bin/tauri ]; then
  note "Installing web dependencies (first run)…"
  (cd web && npm install)
fi

# --- Launch ------------------------------------------------------------------
# `tauri dev` starts Vite itself via beforeDevCommand in tauri.conf.json,
# then builds + runs the Rust shell with hot-reload for both layers.
note "Starting Tubbie (Vite + Tauri shell)…"
exec web/node_modules/.bin/tauri dev --config src-tauri/tauri.conf.json
